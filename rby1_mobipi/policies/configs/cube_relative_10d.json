    "unet": {
      "enabled": true,
      "diffusion_step_embed_dim": 256,
      "down_dims": [
        256,
        512,
        1024
      ],
      "kernel_size": 5,
      "n_groups": 8
    },
    "ema": {
      "enabled": true,
      "power": 0.75
    },
    "language_conditioned": false,
    "relative_actions": {
      "enabled": true,
      "arm": "right",
