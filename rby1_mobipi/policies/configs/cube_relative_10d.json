      },
      "actions_gripper": {
        "normalization": "min_max"
      }
    },
    "goal_mode": null,
    "cuda": true,
    "batch_size": 8,
    "num_epochs": 15,
    "seed": 2026,
    "max_grad_norm": null,
    "data_format": "robomimic",
    "shuffled_obs_key_groups": null,
    "drop_last": false
