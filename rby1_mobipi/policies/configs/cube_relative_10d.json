  "algo": {
    "optim_params": {
      "policy": {
        "learning_rate": {
          "initial": 0.0001,
          "decay_factor": 0.1,
          "epoch_schedule": [],
          "scheduler_type": "constant"
        },
        "regularization": {
          "L2": 0.0
        }
      }
    },
    "horizon": {
      "observation_horizon": 2,
      "action_horizon": 8,
      "prediction_horizon": 16
