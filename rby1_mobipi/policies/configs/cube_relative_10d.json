        "right_ee_pos",
        "right_ee_quat"
      ],
      "quaternion_order": "wxyz"
    },
    "ddpm": {
      "enabled": false,
      "num_train_timesteps": 100,
      "num_inference_timesteps": 100,
      "beta_schedule": "squaredcos_cap_v2",
      "clip_sample": true,
      "prediction_type": "epsilon"
    },
    "ddim": {
      "enabled": true,
      "num_train_timesteps": 100,
      "num_inference_timesteps": 10,
      "beta_schedule": "squaredcos_cap_v2",
      "clip_sample": true,
      "set_alpha_to_one": true,
      "steps_offset": 0,
      "prediction_type": "epsilon"
    }
  },
  "observation": {
    "modalities": {
      "obs": {
        "low_dim": [
